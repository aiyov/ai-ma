# Leave API_KEY empty for local use. Set it before exposing the API.
API_KEY=
# Required for chat. Key from Alibaba Cloud Model Studio (百炼).
DASHSCOPE_API_KEY=
QWEN_MODEL=qwen-plus
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_TIMEOUT=20
QWEN_MAX_RETRIES=2

# Copy to .env before exposing these ports beyond localhost.
REDIS_PASSWORD=change-me-local-dev
# Optional. Defaults to redis://:{REDIS_PASSWORD}@localhost:6379/0
# REDIS_URL=
# Chat history TTL in seconds (Redis or in-memory fallback).
CHAT_SESSION_TTL=86400

# Catalog sync (mock file source today; swap SYNC_SOURCE for an ATG adapter later).
SYNC_SOURCE=file
SYNC_STATE_PATH=.cache/sync_state.sqlite
SYNC_INTERVAL_SECONDS=3600

# Used only with: docker compose --profile storage up -d
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
